---
// Scroll Ring (port of the Framer ScrollRing code component): images spaced
// evenly around a circle; wheel / touch scrolling spins the ring, with a gentle
// idle spin. Never captures pointer events.
interface Props {
  images: string[];
  radius?: number;
  scrollSpeed?: number;
  autoSpin?: number;
}
const { images, radius = 360, scrollSpeed = 0.02, autoSpin = 2 } = Astro.props;
const n = images.length || 1;
---
<div class="nf-ring" aria-hidden="true" data-ring data-radius={radius} data-speed={scrollSpeed} data-spin={autoSpin}>
  <div class="nf-ring-wheel" style={`--r: ${Math.min(radius, 240)}`} data-wheel>
    {images.map((src, i) => <img src={src} alt="" draggable="false" style={`--a: ${(i / n) * 360}deg`} />)}
  </div>
</div>
