---
import { site } from "../../lib/site";
const services = site.services;
const n = services.length;
const pad = (v: number) => String(v).padStart(2, "0");
---
<section class="services container">
  <div id="servicesScroll" class="services-scroll" data-services data-captions={JSON.stringify(services.map((s) => s.captions))}>
    <div class="services-switcher">
      <div class="services-top">
        <p class="body" style="color: var(--grey)">SERVICES</p>
        <p class="caption"><span data-counter>01</span> / {pad(n)}</p>
      </div>
      <div class="services-middle">
        <div class="services-names">
          {services.map((s, i) => (
            <h2 class="h2 balance services-name" style={`color: ${i === 0 ? "var(--white)" : "var(--white-60)"}`} data-name={i}>{s.name}</h2>
          ))}
        </div>
        <div class="services-detail">
          <div class="services-image">
            {services.map((s, i) => <img class={i === 0 ? "is-on" : undefined} src={s.image} alt={s.alt} loading="lazy" />)}
          </div>
          <div class="services-captions" data-caps>
            {services[0].captions.map((c) => <p class="body">{c}</p>)}
          </div>
        </div>
      </div>
      <div class="services-progress">
        <div class="services-fill" style={`width: ${(1 / n) * 100}%`} data-fill></div>
      </div>
    </div>
  </div>
</section>
