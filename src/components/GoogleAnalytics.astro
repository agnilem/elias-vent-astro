---
/**
 * Google Analytics for the live demo only. Renders nothing unless PUBLIC_GA_ID is
 * set, and that is set only in the demo's Vercel project, so your copy ships without it.
 */
const id = import.meta.env.PUBLIC_GA_ID;
---
{id && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", id);
    // Fetch the tag once the page has finished loading, or on the first interaction, whichever comes first.
    let done = false;
    const events = ["pointerdown", "keydown", "scroll", "touchstart"];
    const load = () => {
      if (done) return;
      done = true;
      events.forEach((e) => removeEventListener(e, load));
      const s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
      document.head.appendChild(s);
    };
    events.forEach((e) => addEventListener(e, load, { passive: true, once: true }));
    addEventListener("load", () => setTimeout(load, 3500));
  </script>
)}
